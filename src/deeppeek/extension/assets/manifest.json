{
  "manifest_version": 3,
  "name": "DeepSeek Chat Exporter (DSX)",
  "version": "0.4.0",
  "description": "Send a DeepSeek conversation to the deeppeek CLI for Markdown export.",
  "browser_specific_settings": {
    "gecko": {
      "id": "dsx@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["scripting", "activeTab", "storage", "unlimitedStorage", "contextualIdentities", "cookies"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "bg-state.js",
      "bg-onmessage.js",
      "bg-handlers-control.js",
      "bg-handlers-composer.js",
      "bg-handlers-read.js",
      "bg-handlers-hijack.js",
      "bg-sse.js",
      "bg-watchdog.js",
      "bg-fire.js",
      "bg-tabs.js",
      "bg-main.js"
    ]
  },
  "action": {
    "default_title": "Send chat to dsx"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "injected-idb.js",
        "injected-fiber.js",
        "injected-watch.js",
        "injected-extract.js",
        "injected-fetch.js",
        "injected-attach.js",
        "injected-composer.js",
        "injected-clear.js",
        "injected-attachments.js",
        "injected-retry.js",
        "injected-hijack.js",
        "injected-buttons.js",
        "button-rules/_manifest.json",
        "button-rules/*.js"
      ],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ]
}
